{
  "name": "emitter-ts",
  "version": "1.0.0",
  "description": "Strict typed event emitter for TypeScript with sync/async dispatch, once/off semantics, listener-error isolation, and zero runtime dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest --verbose",
    "test:coverage": "jest --coverage --verbose",
    "typecheck": "tsc --noEmit",
    "pretest": "node --test dependency-audit.test.cjs"
  },
  "keywords": [
    "event-emitter",
    "events",
    "emitter",
    "pubsub",
    "typed",
    "typescript",
    "async",
    "once",
    "off",
    "subscribe",
    "zero-dependency"
  ],
  "author": "Nripanka Das <nripankadas@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nripankadas07/emitter-ts.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "js-yaml": {
      "argparse": "2.0.1"
    }
  }
}
